<Window x:Class="Ets2SaveEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Ets2SaveEditor.Views"
        Title="Ets2SaveEditor - 欧卡2 存档修改器" Height="660" Width="1000">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem x:Name="MiOpenFile" Header="打开文件..." Click="MiOpenFile_Click"/>
                <MenuItem x:Name="MiOpenFolder" Header="打开文件夹..." Click="MiOpenFolder_Click"/>
                <MenuItem x:Name="MiSave" Header="保存(_S)" Click="MiSave_Click"/>
                <MenuItem x:Name="MiSaveAs" Header="另存为..." Click="MiSaveAs_Click"/>
                <Separator/>
                <MenuItem x:Name="MiExit" Header="退出" Click="MiExit_Click"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem x:Name="MiAbout" Header="关于 / 免责声明" Click="MiAbout_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="6">
                <Button x:Name="BtnRefresh" Content="刷新存档列表" DockPanel.Dock="Top" Margin="0,0,0,4" Click="BtnRefresh_Click"/>
                <TextBlock Text="存档槽（来自文档/Steam）" DockPanel.Dock="Top" FontWeight="Bold"/>
                <ListBox x:Name="LbSlots" ItemsSource="{Binding SaveSlots}" DisplayMemberPath="Display"
                         SelectionChanged="LbSlots_SelectionChanged" Height="170" Margin="0,2,0,6"/>
                <TextBlock Text="存档文件 (.sii)" DockPanel.Dock="Top" FontWeight="Bold"/>
                <ListBox x:Name="LbFiles" MouseDoubleClick="LbFiles_MouseDoubleClick"/>
            </DockPanel>

            <TabControl Grid.Column="1" Margin="6">
                <TabItem Header="档案">
                    <views:ProfileView DataContext="{Binding Profile}"/>
                </TabItem>
                <TabItem Header="车库">
                    <views:GaragesView DataContext="{Binding Garages}"/>
                </TabItem>
                <TabItem Header="卡车">
                    <views:TruckView DataContext="{Binding Truck}"/>
                </TabItem>
                <TabItem Header="挂车">
                    <views:TrailerView DataContext="{Binding Trailer}"/>
                </TabItem>
                <TabItem Header="货运市场">
                    <views:FreightMarketView DataContext="{Binding Freight}"/>
                </TabItem>
                <TabItem Header="货物">
                    <views:CargoView DataContext="{Binding Cargo}"/>
                </TabItem>
                <TabItem Header="设置">
                    <views:SettingsView DataContext="{Binding Settings}"/>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
