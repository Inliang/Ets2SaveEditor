<Window x:Class="Ets2SaveEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Ets2SaveEditor.Views"
        Title="欧卡2 存档修改器" Height="700" Width="1060"
        Icon="pack://application:,,,/Ets2SaveEditor;component/Assets/appicon.ico">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件(_F)">
                <MenuItem x:Name="MiOpenFile" Header="打开文件..." Click="MiOpenFile_Click"/>
                <MenuItem x:Name="MiOpenFolder" Header="打开文件夹..." Click="MiOpenFolder_Click"/>
                <MenuItem x:Name="MiSave" Header="保存(_S)" Click="MiSave_Click"/>
                <MenuItem x:Name="MiSaveAs" Header="另存为..." Click="MiSaveAs_Click"/>
                <Separator/>
                <MenuItem x:Name="MiExit" Header="退出" Click="MiExit_Click"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem x:Name="MiAbout" Header="关于 / 免责声明" Click="MiAbout_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：存档槽 / 文件列表 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="8">
                <DockPanel>
                    <Button x:Name="BtnRefresh" Content="刷新存档列表" DockPanel.Dock="Top" Margin="0,0,0,6" Click="BtnRefresh_Click"/>
                    <TextBlock Text="存档槽（来自文档 / Steam）" DockPanel.Dock="Top" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                    <ListBox x:Name="LbSlots" ItemsSource="{Binding SaveSlots}" DisplayMemberPath="Display"
                             SelectionChanged="LbSlots_SelectionChanged" Height="180" Margin="0,0,0,8"/>
                    <TextBlock Text="存档文件 (.sii)" DockPanel.Dock="Top" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                    <ListBox x:Name="LbFiles" MouseDoubleClick="LbFiles_MouseDoubleClick"/>
                </DockPanel>
            </Border>

            <!-- 右侧：功能页签 -->
            <TabControl Grid.Column="1" Margin="0,8,8,8" Background="{StaticResource BgBrush}" BorderThickness="0">
                <TabItem Header="档案">
                    <Border Style="{StaticResource CardStyle}" Margin="6">
                        <views:ProfileView DataContext="{Binding Profile}"/>
                    </Border>
                </TabItem>
                <TabItem Header="车库">
                    <Border Style="{StaticResource CardStyle}" Margin="6">
                        <views:GaragesView DataContext="{Binding Garages}"/>
                    </Border>
                </TabItem>
                <TabItem Header="卡车">
                    <Border Style="{StaticResource CardStyle}" Margin="6">
                        <views:TruckView DataContext="{Binding Truck}"/>
                    </Border>
                </TabItem>
                <TabItem Header="挂车">
                    <Border Style="{StaticResource CardStyle}" Margin="6">
                        <views:TrailerView DataContext="{Binding Trailer}"/>
                    </Border>
                </TabItem>
                <TabItem Header="货运市场">
                    <Border Style="{StaticResource CardStyle}" Margin="6">
                        <views:FreightMarketView DataContext="{Binding Freight}"/>
                    </Border>
                </TabItem>
                <TabItem Header="货物">
                    <Border Style="{StaticResource CardStyle}" Margin="6">
                        <views:CargoView DataContext="{Binding Cargo}"/>
                    </Border>
                </TabItem>
                <TabItem Header="设置">
                    <Border Style="{StaticResource CardStyle}" Margin="6">
                        <views:SettingsView DataContext="{Binding Settings}"/>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
