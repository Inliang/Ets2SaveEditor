<UserControl x:Class="Ets2SaveEditor.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:Ets2SaveEditor.Views"
             mc:Ignorable="d" d:DesignHeight="420" d:DesignWidth="520">
    <ScrollViewer Margin="0">
        <StackPanel>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="玩家档案" FontWeight="Bold" FontSize="15" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="账户金钱" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Money}" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="经验值" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Experience}" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="当前等级" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LevelText}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="距离下一级" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LevelProgress}" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="目标等级" VerticalAlignment="Center" Margin="0,4"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Level}" Margin="0,4"
                                 ToolTip="填写目标等级即可直接设置等级：会自动换算成该等级对应的累计经验值写入存档。"/>
                    </Grid>
                    <TextBlock Text="提示：等级由经验值自动推导；填写「目标等级」可直接设置等级（会换算成对应的经验值）。"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="驾驶技能（点亮几枚即为几级，点击可增减）" FontWeight="Bold" FontSize="15" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                    <StackPanel Margin="0,0,0,10">
                        <views:SkillIconControl Title="长途运输" SkillIndex="0"
                                                 Level="{Binding LongDist, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <views:SkillIconControl Title="重载货物" SkillIndex="1"
                                                 Level="{Binding Heavy, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <views:SkillIconControl Title="易碎品" SkillIndex="2"
                                                 Level="{Binding Fragile, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <views:SkillIconControl Title="高时效" SkillIndex="3"
                                                 Level="{Binding Urgent, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <views:SkillIconControl Title="节油驾驶" SkillIndex="4"
                                                 Level="{Binding EcoDriving, Mode=TwoWay}"/>
                    </StackPanel>
                    <TextBlock Text="提示：修改后点顶部工具栏的「保存」写回存档，游戏加载时会自动重新压缩。" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
