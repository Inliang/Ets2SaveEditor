<UserControl x:Class="Ets2SaveEditor.Views.FreightMarketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="420" d:DesignWidth="600">
    <DockPanel>
        <!-- 新建自定义任务 -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="新建自定义货运任务" FontWeight="Bold" Margin="0,0,0,6"/>
                <WrapPanel>
                    <TextBlock Text="收货公司" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding CompanyFilter, UpdateSourceTrigger=PropertyChanged}"
                             Width="120" VerticalAlignment="Center" Margin="0,0,12,0"
                             ToolTip="按公司名或城市名筛选"/>
                    <ComboBox ItemsSource="{Binding Companies}" SelectedItem="{Binding SelectedCompany}"
                              Width="230" Margin="0,0,12,0" DisplayMemberPath="ToString"
                              ToolTip="选择接收货物的公司"/>
                    <TextBlock Text="货物" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding CargoChoices}" SelectedItem="{Binding SelectedCargo}"
                              Width="180" Margin="0,0,12,0" DisplayMemberPath="ToString"
                              ToolTip="选择货物种类"/>
                    <TextBlock Text="数量" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding NewUnits, UpdateSourceTrigger=LostFocus}"
                             Width="50" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="距离(km)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding NewDistance, UpdateSourceTrigger=LostFocus}"
                             Width="70" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="紧急度" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox SelectedItem="{Binding NewUrgency}" Width="62" Margin="0,0,12,0">
                        <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">0</sys:Int32>
                        <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">1</sys:Int32>
                        <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">2</sys:Int32>
                        <sys:Int32 xmlns:sys="clr-namespace:System;assembly=mscorlib">3</sys:Int32>
                    </ComboBox>
                    <Button Content="创建任务" Command="{Binding CreateJobCommand}" Padding="12,5"/>
                    <Button Content="删除所选" Command="{Binding DeleteJobCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=Dg}" Padding="12,5" Margin="8,0,0,0"/>
                </WrapPanel>
                <TextBlock Text="提示：游戏不保存任务报酬，而是按「货物 × 距离 × 紧急度」实时计算。下表的「预估报酬」按真实存档中实测的单位费率换算，仅供参考。"
                           Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Status}" Margin="0,4,0,0" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 任务列表 -->
        <DataGrid x:Name="Dg" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="收货公司" Binding="{Binding TargetCompanyName}" Width="120"/>
                <DataGridTextColumn Header="城市" Binding="{Binding TargetCityName}" Width="100"/>
                <DataGridTextColumn Header="货物" Binding="{Binding CargoName}" Width="130"/>
                <DataGridTextColumn Header="公司车辆" Binding="{Binding TruckName}" Width="140"/>
                <DataGridTextColumn Header="距离(km)" Binding="{Binding DistanceKm}" Width="74"/>
                <DataGridTextColumn Header="紧急度" Binding="{Binding Urgency}" Width="55"/>
                <DataGridTextColumn Header="单位数" Binding="{Binding UnitsCount}" Width="58"/>
                <DataGridTextColumn Header="预估报酬" Binding="{Binding EstimatedIncomeText}" Width="86"/>
                <DataGridTextColumn Header="每公里报酬" Binding="{Binding EstimatedIncomePerKmText}" Width="96"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
